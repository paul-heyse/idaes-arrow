# direnv configuration for idaes-arrow.
#
# Contract: entering this directory is FAST and touches NO network. This file
# exports variables, puts the project's own tools first on PATH, and reports
# what is missing. It never creates a venv, installs a package, or downloads
# anything -- `just bootstrap` does that, deliberately and visibly.
#
# First time here:  direnv allow

# The interpreter this project develops against. `.python-version` is the single
# source of truth; uv reads it directly, and scripts/doctor.py checks .venv
# against it.
export IDAES_PYTHON="${IDAES_PYTHON:-$(cat .python-version 2>/dev/null || echo 3.14.7)}"

# Matches the global setting in ~/.codex/config.toml so Codex and Claude Code
# resolve the same environment.
export UV_PROJECT_ENVIRONMENT=.venv

# auto | force | off. `auto` uses the Rust extension when importable and falls
# back to pure Python otherwise; see idaes/accel/__init__.py.
export IDAES_ACCEL="${IDAES_ACCEL:-auto}"

# Keep Cargo output inside the repo so `just` recipes, rust-analyzer and CI all
# agree on one target directory.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/rust/target}"

# Project tools before machine-global ones. This is what stops a stale
# ~/.local/bin/ruff from shadowing the version pinned in pyproject.toml --
# exactly the drift that produced a phantom formatting diff on this repo before.
PATH_add "$PWD/.venv/bin"

# idaes/config.py::setup_environment() prepends this at import time anyway;
# putting it on PATH up front means `ipopt -v` works in a plain shell.
PATH_add "${IDAES_DATA:-$HOME/.idaes}/bin"

# Re-evaluate when any of these change, so a toolchain bump is picked up on the
# next `cd` rather than silently ignored.
watch_file .python-version
watch_file pyproject.toml
watch_file rust/rust-toolchain.toml

# Personal, machine-local overrides. Gitignored; see .envrc.local.example.
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi

# Status block. Uses the system python deliberately: it has to work before the
# venv exists, which is precisely when you need to be told what to do.
if [ -x scripts/doctor.py ]; then
  python3 scripts/doctor.py --format=direnv || true
fi
